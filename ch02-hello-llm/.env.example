# LLM API 地址（与 ch01 保持一致）
# 二选一：
# 1) 直接配置 BASE_URL
BASE_URL=
# 2) 在 CNB 平台运行时由平台自动注入：CNB_API_ENDPOINT + CNB_REPO_SLUG
# CNB_API_ENDPOINT=
# CNB_REPO_SLUG=

# API Key
# 二选一：API_KEY 或 CNB_TOKEN（CNB 平台自动注入）
API_KEY=
# CNB_TOKEN=

# 模型 ID，默认 hunyuan-turbos-latest
MODEL_ID=hunyuan-turbos-latest

# 请求超时（秒）
LLM_TIMEOUT=60
